# =============================================================================
# Local Lead AI — Environment Variables
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# Get these from: https://app.supabase.com → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Apify — Google Maps Scraper
# Get token from: https://console.apify.com/account/integrations
# Actor ID for Google Maps scraper (do not change unless using alternative actor)
# -----------------------------------------------------------------------------
APIFY_API_TOKEN=apify_api_your-token-here
APIFY_ACTOR_ID=compass/google-maps-scraper

# -----------------------------------------------------------------------------
# WhatsApp Cloud API (Meta)
# Setup guide: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# -----------------------------------------------------------------------------
# Found in: Meta Developer Console → WhatsApp → API Setup → Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Permanent system user access token (not temporary token)
# Create at: Meta Business Suite → System Users → Add Asset
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token

# Custom string you choose — must match what you set in Meta webhook config
WHATSAPP_VERIFY_TOKEN=your-custom-verify-token-string

# E.164 format (no + prefix) — the number that receives alerts
WHATSAPP_OWNER_PHONE=919727686181

# -----------------------------------------------------------------------------
# Claude AI (Anthropic)
# Get key from: https://console.anthropic.com/settings/keys
# -----------------------------------------------------------------------------
CLAUDE_API_KEY=sk-ant-api03-your-key-here

# Claude model to use for message generation (claude-3-5-sonnet-20241022 recommended)
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# -----------------------------------------------------------------------------
# Google Drive API
# Setup guide: https://console.cloud.google.com/apis/credentials
# Enable: Google Drive API + Google Sheets API
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
# The Drive folder ID where exported Excel/CSV files will be saved
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

# -----------------------------------------------------------------------------
# n8n Automation
# Your self-hosted or cloud n8n instance
# -----------------------------------------------------------------------------
N8N_BASE_URL=https://n8n.yourdomain.com
# Shared secret for webhook authentication between Next.js and n8n
N8N_WEBHOOK_SECRET=your-random-32-char-secret-string

# Webhook IDs from your imported n8n workflows
N8N_WHATSAPP_WEBHOOK_ID=your-whatsapp-webhook-id
N8N_OUTREACH_WEBHOOK_ID=your-outreach-webhook-id
N8N_FOLLOWUP_WEBHOOK_ID=your-followup-webhook-id

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-app.yourdomain.com

# Optional: override default timezone (default: Asia/Kolkata)
TZ=Asia/Kolkata
