{
  "name": "04 - Follow-Up Engine",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 */4 * * *"
            }
          ]
        }
      },
      "id": "cc000001-0001-0001-0001-100000000001",
      "name": "Every 4 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.NEXT_PUBLIC_APP_URL }}/api/followups/pending",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "cc000002-0002-0002-0002-200000000002",
      "name": "Get Pending Follow-Ups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cc000003-0003-0003-0003-300000000003",
              "leftValue": "={{ $json.pending_followups.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "cc000004-0004-0004-0004-400000000004",
      "name": "Has Pending Follow-Ups?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "pending_followups",
        "options": {}
      },
      "id": "cc000005-0005-0005-0005-500000000005",
      "name": "Split Follow-Ups",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [900, 220]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "cc000006-0006-0006-0006-600000000006",
      "name": "Process One Follow-Up at a Time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1120, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXT_PUBLIC_APP_URL }}/api/followups/execute",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"follow_up_queue_id\": \"{{ $json.id }}\"\n}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "onError": "continueErrorOutput"
      },
      "id": "cc000007-0007-0007-0007-700000000007",
      "name": "Execute Follow-Up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 220]
    },
    {
      "parameters": {
        "unit": "seconds",
        "amount": 5
      },
      "id": "cc000008-0008-0008-0008-800000000008",
      "name": "Wait 5 Seconds",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1560, 220]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cc000009-0009-0009-0009-900000000009",
              "name": "error_follow_up_id",
              "value": "={{ $json.id ?? 'unknown' }}",
              "type": "string"
            },
            {
              "id": "cc000010-0010-0010-0010-101000000010",
              "name": "error_message",
              "value": "={{ $json.message ?? 'Unknown error' }}",
              "type": "string"
            },
            {
              "id": "cc000011-0011-0011-0011-111100000011",
              "name": "error_timestamp",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "cc000012-0012-0012-0012-121200000012",
      "name": "Log Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1560, 380]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cc000013-0013-0013-0013-131300000013",
              "name": "skipped_reason",
              "value": "No pending follow-ups at this time",
              "type": "string"
            },
            {
              "id": "cc000014-0014-0014-0014-141400000014",
              "name": "checked_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "cc000015-0015-0015-0015-151500000015",
      "name": "No Follow-Ups - Skip",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [900, 380]
    }
  ],
  "connections": {
    "Every 4 Hours": {
      "main": [
        [
          {
            "node": "Get Pending Follow-Ups",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Pending Follow-Ups": {
      "main": [
        [
          {
            "node": "Has Pending Follow-Ups?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Pending Follow-Ups?": {
      "main": [
        [
          {
            "node": "Split Follow-Ups",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Follow-Ups - Skip",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Follow-Ups": {
      "main": [
        [
          {
            "node": "Process One Follow-Up at a Time",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process One Follow-Up at a Time": {
      "main": [
        [
          {
            "node": "Execute Follow-Up",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Execute Follow-Up": {
      "main": [
        [
          {
            "node": "Wait 5 Seconds",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 5 Seconds": {
      "main": [
        [
          {
            "node": "Process One Follow-Up at a Time",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "44444444-aaaa-bbbb-cccc-dddddddddddd",
  "id": "workflow-04-followup-engine-localleadai"
}
